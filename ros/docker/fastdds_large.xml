<?xml version="1.0" encoding="UTF-8"?>
<!-- Fast DDS profile for multi-megabyte point clouds (8 MB per OT128 frame).
     The default shared-memory segment (0.5 MB) cannot hold a cloud, so Fast DDS falls back to UDP
     fragments, and at 10 Hz a reliable writer with the recorded history depth (10) loses frames
     (measured: 51 of 1510 on the organisers' bag). A large segment carries whole clouds through
     shared memory; UDP stays for other hosts. Needs /dev/shm room: docker run with ipc=host or
     shm-size >= 1g (otherwise Fast DDS falls back to UDP). Opt-in: METRO_FASTDDS_LARGE=1 makes the
     entry point export FASTRTPS_DEFAULT_PROFILES_FILE. Measured: removed the losses on
     roundT_doubleT, not on the organisers' bag (the QoS override on the player is what matters). -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>shm_large</transport_id>
      <type>SHM</type>
      <segment_size>134217728</segment_size>
      <maxMessageSize>33554432</maxMessageSize>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>udp</transport_id>
      <type>UDPv4</type>
      <sendBufferSize>16777216</sendBufferSize>
      <receiveBufferSize>16777216</receiveBufferSize>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="metro_large_messages" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>shm_large</transport_id>
        <transport_id>udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
